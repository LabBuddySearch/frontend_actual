PORT=4000
APP_URL=http://127.0.0.1:3000

# Куда Vite проксирует /api при `npm run dev` (по умолчанию мок на :4000).
# Для Spring Boot на 8080: VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Для реальной отправки письма (иначе ссылка только в консоли сервера):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
